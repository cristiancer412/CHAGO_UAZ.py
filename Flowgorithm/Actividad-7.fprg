<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Actividad-7"/>
        <attribute name="authors" value="crist"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 08:47:13 p. m."/>
        <attribute name="created" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswODo0MjoyMyBwLiBtLjsyMzk3"/>
        <attribute name="edited" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswODo0NzoxMyBwLiBtLjsyOzI1MTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, x, f" type="Integer" array="False" size=""/>
            <output expression="&quot;Dame un n&#250;mero: &quot;" newline="True"/>
            <input variable="n"/>
            <if expression="n &gt; 0">
                <then>
                    <assign variable="f" expression="0"/>
                    <output expression="&quot;Seg&#250;n la funci&#243;n, la serie es:&quot;" newline="True"/>
                    <output expression="f" newline="True"/>
                    <for variable="x" start="1" end="n" direction="inc" step="1">
                        <assign variable="f" expression="2 * f + x^2"/>
                        <output expression="f" newline="True"/>
                    </for>
                </then>
                <else>
                    <output expression="&quot;El n&#250;mero debe ser un entero positivo&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>

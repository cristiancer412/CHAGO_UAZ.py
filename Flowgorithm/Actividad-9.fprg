<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Actividad-9"/>
        <attribute name="authors" value="crist"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 09:07:46 p. m."/>
        <attribute name="created" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswOTowMzowMiBwLiBtLjsyMzky"/>
        <attribute name="edited" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswOTowNzo0NiBwLiBtLjsxOzI1MTI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x, sumaTerminos" type="Real" array="False" size=""/>
            <declare name="n, i" type="Integer" array="False" size=""/>
            <assign variable="x" expression="2.0"/>
            <while expression="x &lt;= -1 || x &gt; 1">
                <output expression="&quot;Teclee argumento x?&quot;" newline="True"/>
                <input variable="x"/>
                <if expression="x &lt;= -1 || x &gt; 1">
                    <then>
                        <output expression="&quot;Error, valor de x inv&#225;lido&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
            <output expression="&quot;Hasta cuantos t&#233;rminos de la serie?&quot;" newline="True"/>
            <input variable="n"/>
            <assign variable="sumaTerminos" expression="0.0"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <assign variable="sumaTerminos" expression="sumaTerminos + ((-1)^(i - 1) * (x^i)) / i"/>
            </for>
            <output expression="&quot;ln(1+x) = &quot; &amp; ToFixed(sumaTerminos, 6)" newline="True"/>
        </body>
    </function>
</flowgorithm>

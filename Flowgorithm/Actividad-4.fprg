<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Actividad-4"/>
        <attribute name="authors" value="crist"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 07:28:30 p. m."/>
        <attribute name="created" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0xOTswNjoyNjozMiBwLiBtLjsyNDA1"/>
        <attribute name="edited" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswNzoyODozMCBwLiBtLjszOzI1MDg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3, suma1, suma2, suma3, mayor" type="Real" array="False" size=""/>
            <output expression="&quot;Dame el n&#250;mero n1:&quot;" newline="True"/>
            <input variable="n1"/>
            <output expression="&quot;Dame el n&#250;mero n2:&quot;" newline="True"/>
            <input variable="n2"/>
            <output expression="&quot;Dame el n&#250;mero n3:&quot;" newline="True"/>
            <input variable="n3"/>
            <if expression="n1 &gt; 0 &amp;&amp; n2 &gt; 0 &amp;&amp; n3 &gt; 0">
                <then>
                    <assign variable="suma1" expression="Int(n1) + Int((n1 - Int(n1)) * 10000 + 0.5)"/>
                    <assign variable="suma2" expression="Int(n2) + Int((n2 - Int(n2)) * 10000 + 0.5)"/>
                    <assign variable="suma3" expression="Int(n3) + Int((n3 - Int(n3)) * 10000 + 0.5)"/>
                    <assign variable="mayor" expression="suma1"/>
                </then>
                <else>
                    <output expression="&quot;Alguno o varios de los n&#250;meros no son positivos&quot;" newline="True"/>
                </else>
            </if>
            <if expression="suma1 &gt;= suma2 &amp;&amp; suma1 &gt;= suma3">
                <then>
                    <assign variable="mayor" expression="suma1"/>
                </then>
                <else>
                    <if expression="suma2 &gt;= suma3">
                        <then>
                            <assign variable="mayor" expression="suma2"/>
                        </then>
                        <else>
                            <assign variable="mayor" expression="suma3"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;La suma resultante de n1 = &quot; &amp; ToFixed(suma1, 4)" newline="True"/>
            <output expression="&quot;La suma resultante de n2 = &quot; &amp; ToFixed(suma2, 4)" newline="True"/>
            <output expression="&quot;La suma resultante de n3 = &quot; &amp; ToFixed(suma3, 4)" newline="True"/>
            <output expression="&quot;El valor mayor de las sumas es &quot; &amp; ToFixed(mayor, 4)" newline="True"/>
        </body>
    </function>
</flowgorithm>

<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Actividad-11"/>
        <attribute name="authors" value="crist"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 09:44:06 p. m."/>
        <attribute name="created" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswOToyNzoxOCBwLiBtLjsyNDA1"/>
        <attribute name="edited" value="Y3Jpc3Q7TElHSFQ7MjAyNi0wOS0yMDswOTo0NDowNiBwLiBtLjsyOzI1MTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num, suma, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Dame un n&#250;mero para verificar si es perfecto: &quot;" newline="True"/>
            <input variable="num"/>
            <while expression="num != 0">
                <if expression="num &lt; 0">
                    <then>
                        <output expression="&quot;El &quot; &amp; num &amp; &quot; no es positivo&quot;" newline="True"/>
                    </then>
                    <else>
                        <assign variable="suma" expression="0"/>
                        <for variable="i" start="1" end="num-1" direction="inc" step="1">
                            <if expression="num % i == 0">
                                <then>
                                    <assign variable="suma" expression="suma+i"/>
                                </then>
                                <else/>
                            </if>
                        </for>
                    </else>
                </if>
                <if expression="suma==num">
                    <then>
                        <output expression="&quot;El &quot; &amp; num &amp;&quot; s&#237; es perfecto.&quot;" newline="True"/>
                    </then>
                    <else>
                        <output expression="&quot;El &quot; &amp; num &amp;&quot; no es perfecto.&quot;" newline="True"/>
                    </else>
                </if>
                <output expression="&quot;Dame un n&#250;mero para verificar si es perfecto: &quot;" newline="True"/>
                <input variable="num"/>
            </while>
            <output expression="&quot;Fin de algoritmo&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
